# FastAPI MCP Server 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 项目配置
PROJECT_NAME=Mail MCP Server
VERSION=1.0.0
API_V1_STR=/api/v1

# 安全配置
# 必须设置：用于API Key鉴权的密钥
MCP_API_KEY=your-secret-api-key-here-change-in-production

# 允许的Origin列表（CORS配置）
# 生产环境必须严格配置，禁止使用通配符
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# 邮件服务配置
# 必须设置：Fernet 加密密钥（可通过 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成）
USER_STORE_ENCRYPTION_KEY=your-fernet-key-here
# 加密用户配置文件路径
USER_STORE_PATH=data/users.enc
# IMAP 操作超时秒数
IMAP_TIMEOUT=30
# SMTP 操作超时秒数
SMTP_TIMEOUT=30

# 日志配置
LOG_LEVEL=INFO
JSON_LOGS=true

# Prometheus监控配置
PROMETHEUS_ENABLED=true

# HTTP客户端配置
HTTP_CLIENT_TIMEOUT=30.0
HTTP_CLIENT_MAX_KEEPALIVE_CONNECTIONS=50
HTTP_CLIENT_MAX_CONNECTIONS=100

# 服务器配置
HOST=0.0.0.0
PORT=8000
